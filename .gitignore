```gitignore
# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Python / Django
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Python package/build files
build/
dist/
*.egg-info/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Django local files
db.sqlite3
db.sqlite3-journal
media/

# =========================
# Next.js
# =========================
node_modules/
.next/
out/
build/
dist/
.vercel/

# Next.js generated types
next-env.d.ts

# =========================
# Package managers
# =========================
.npm/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Editors
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# OS
# =========================
.DS_Store
Thumbs.db

# =========================
# Temporary files
# =========================
tmp/
temp/
.cache/

# =========================
# local files
# =========================
docs/research/notes-private.md